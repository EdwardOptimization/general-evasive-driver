{
  "env_config": "configs/ppo_m541_matched_l3_variance_4096.json",
  "distribution_version": "v3",
  "notes": "M739 extreme-fault distribution v3. Current-model faults are single-track or axle-level capability changes. Proxy faults may be used for self-ID scenario mining but must not be claimed as true single-wheel physics.",
  "claim_boundary": {
    "current_model_fault": "directly represented by current VehicleParams changes",
    "current_model_proxy": "capability-loss proxy in the single-track model; useful for controller stress but not a true per-wheel failure",
    "future_only_fault": "requires a four-wheel or higher-fidelity dynamics engine before supporting physical claims"
  },
  "future_only_faults": [
    "true_single_wheel_puncture_or_blowout",
    "true_single_wheel_grip_collapse",
    "true_left_right_split_mu_patch",
    "true_stuck_caliper_or_single_wheel_brake_pull",
    "true_single_wheel_brake_pressure_loss",
    "true_asymmetric_half_shaft_torque_loss",
    "per_wheel_abs_fault",
    "wheel_speed_sensor_drop_or_bias",
    "tire_pressure_temperature_or_wear_dynamics",
    "corner_suspension_damage",
    "road_crown_or_bank_induced_wheel_load_asymmetry",
    "combined_single_corner_damage"
  ],
  "scenario_axes": {
    "fault_onset": [
      "preexisting",
      "warmup",
      "pre_emergency",
      "emergency_entry",
      "recovery"
    ],
    "difficulty": [
      "healthy_margin",
      "near_boundary",
      "aeb_infeasible",
      "drift_required",
      "mitigation_only"
    ],
    "history_interventions": [
      "normal",
      "reset_hidden",
      "wrong_cross_fault_history",
      "zero_command_history_sequence",
      "delayed_response_sequence"
    ],
    "split_policy": {
      "public": "debug and source mining",
      "holdout": "promotion-only; rotate if used for repair"
    }
  },
