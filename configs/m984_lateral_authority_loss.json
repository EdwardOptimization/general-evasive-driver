{
  "ppo": {
    "total_steps": 4096,
    "rollout_steps": 64,
    "num_envs": 4,
    "update_epochs": 2,
    "minibatch_size": 128,
    "hidden_size": 64,
    "learning_rate": 0.0003,
    "log_std_init": -1.0,
    "log_std_max": -0.5,
    "actor_encoder": "human_view_online_gru",
    "actor_history_length": 1,
    "history_baseline_level": "L3_online_gru",
    "recurrent_sequence_training": true,
    "eval_episodes": 5,
    "seed": 9842,
    "device": "cpu"
  },
  "env": {
    "track_kind": "circle",
    "track_radius": 60.0,
    "track_width": 7.5,
    "history_length": 1,
    "action_history_mode": "full",
    "obstacle_relative_velocity_mode": "zero",
    "road_lookahead_count": 8,
    "road_lookahead_spacing": 5.0,
    "obstacle_slots": 4,
    "termination_penalty": 8.0,
    "speed_range": [13.5, 20.5],
    "beta_target_range": [0.04, 0.32],
    "friction_limited_speed": false,
    "friction_step": {
      "enabled": true,
      "step_range": [4, 28],
      "mu_range": [0.12, 0.75],
      "resample_speed_ref": false
    },
    "obstacle": {
      "enabled": true,
      "distance_range": [3.0, 24.0],
      "half_width_range": [0.70, 1.65],
      "collision_penalty": 25.0,
      "require_aeb_infeasible": true,
      "allowed_labels": ["aes_feasible", "drift_required", "unavoidable"],
      "max_sample_attempts": 50000,
      "finish_on_pass": true,
      "pass_reward": 12.0,
      "stable_aes_beta_limit": 0.18,
      "stable_aes_sideslip_penalty": 2.8,
      "stable_aes_drift_bonus_scale": 0.18,
      "max_threshold_score": 0.90,
      "min_time_after_friction_step": 0.15,
      "perception_reveal_distance": 5.0
    },
    "randomization": {
      "mu_range": [0.18, 0.85],
      "mass_scale_range": [0.85, 1.45],
      "cg_shift_range": [-0.22, 0.22],
      "inertia_scale_range": [0.80, 1.55],
      "tire_stiffness_scale_range": [0.18, 0.65],
      "drive_scale_range": [0.50, 1.20],
      "brake_scale_range": [0.35, 1.20],
      "actuator_tau_scale_range": [1.50, 5.80]
    }
  }
}
