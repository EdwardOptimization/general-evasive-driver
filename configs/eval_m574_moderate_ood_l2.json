{
  "ppo": {
    "total_steps": 4096,
    "rollout_steps": 64,
    "num_envs": 4,
    "update_epochs": 2,
    "minibatch_size": 128,
    "hidden_size": 64,
    "learning_rate": 0.0003,
    "log_std_init": -1.0,
    "log_std_max": -0.5,
    "actor_encoder": "temporal_gru",
    "actor_history_length": 4,
    "history_baseline_level": "L2_finite_window",
    "eval_episodes": 5,
    "seed": 3540,
    "device": "cpu"
  },
  "env": {
    "track_kind": "circle",
    "track_radius": 60.0,
    "track_width": 7.5,
    "history_length": 4,
    "action_history_mode": "full",
    "obstacle_relative_velocity_mode": "zero",
    "road_lookahead_count": 8,
    "road_lookahead_spacing": 5.0,
    "obstacle_slots": 4,
    "termination_penalty": 8.0,
    "speed_range": [14.5, 20.0],
    "beta_target_range": [0.04, 0.32],
    "friction_limited_speed": false,
    "friction_step": {
      "enabled": true,
      "step_range": [4, 28],
      "mu_range": [0.12, 1.00],
      "resample_speed_ref": false
    },
    "obstacle": {
      "enabled": true,
      "distance_range": [4.0, 26.0],
      "half_width_range": [0.60, 1.55],
      "collision_penalty": 25.0,
      "require_aeb_infeasible": true,
      "allowed_labels": ["aes_feasible", "drift_required", "unavoidable"],
      "max_sample_attempts": 30000,
      "finish_on_pass": true,
      "pass_reward": 12.0,
      "stable_aes_beta_limit": 0.18,
      "stable_aes_sideslip_penalty": 2.8,
      "stable_aes_drift_bonus_scale": 0.18,
      "max_threshold_score": 0.60,
      "min_time_after_friction_step": 0.20,
      "perception_reveal_distance": 5.5
    },
    "randomization": {
      "mu_range": [0.12, 0.72],
      "mass_scale_range": [0.80, 1.45],
      "cg_shift_range": [-0.20, 0.20],
      "inertia_scale_range": [0.75, 1.45],
      "tire_stiffness_scale_range": [0.35, 1.50],
      "drive_scale_range": [0.50, 1.40],
      "brake_scale_range": [0.35, 1.40],
      "actuator_tau_scale_range": [1.00, 4.80]
    }
  }
}
